rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isOwner(userId);

      match /usage/{usageId} {
        allow read, write: if isOwner(userId);
      }

      match /chats/{chatId} {
        function isValidChat(data) {
          return data.userId == request.auth.uid
            && (data.title is string && data.title.size() <= 200);
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidChat(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
          
        allow update: if isOwner(userId) 
          && isValidChat(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt;

        match /messages/{messageId} {
          function isValidMessage(data) {
            return data.userId == request.auth.uid
              && (data.role in ['user', 'bot'])
              && (data.content is string && data.content.size() <= 10000);
          }

          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          
          allow create: if isOwner(userId) 
            && isValidMessage(request.resource.data)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time;
            
          allow update: if isOwner(userId)
            && isValidMessage(request.resource.data)
            && request.resource.data.updatedAt == request.time
            && request.resource.data.createdAt == resource.data.createdAt;
        }
      }
    }

    // Connection test helper
    match /test/connection {
      allow get: if true;
    }
  }
}
