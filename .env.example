# Shate — environment (everything here is OPTIONAL)
# Copy this file to .env and fill in only what you want to use. Never commit .env.
# The default pipeline needs no keys at all: built-in agent TTS + public video + FFmpeg.
# Owner-approved, leak-tolerant keys may also live in the committed `keys.env`
# (lookup order: `.env` wins, `keys.env` is the fallback).

# --- Step 03: Voiceover — optional ElevenLabs upgrade (Path B) ---
# Leave empty to use the agent's built-in speech tool (default, free).
ELEVENLABS_API_KEY=

# Voice IDs for ElevenLabs (optional — if empty, the agent picks by tone/gender and
# records its choice in 03-voiceover/timestamps.json)
NARRATOR_VOICE_ID=
VOICE_A_ID=
VOICE_B_ID=

# --- Step 04: Background — relay cookies are NOT set here. ---
# If the GitHub Actions relay hits YouTube bot checks, add a repository secret
# YT_COOKIES (base64 of a Netscape cookies.txt). See steps/04-background.md.

# --- Step 08: Publish — nothing in .env. ---
# OAuth credentials live in git-ignored `secrets/` (client_secrets.json +
# youtube-token.pickle.enc) and in the Actions secret YT_CLIENT_JSON.
